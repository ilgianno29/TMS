@page "/registro"
@attribute [Authorize]
@inject RegistroListini Registro

<PageTitle>Registro modifiche · Delsy</PageTitle>

<div class="head">
    <div>
        <h1>Registro modifiche</h1>
        <p>Ogni modifica, importazione e approvazione dei listini. Il registro non si può modificare né cancellare.</p>
    </div>
</div>

<section class="panel">
    <form method="get" class="filters">
        <div class="field"><label for="cerca">Testo o contratto</label><input id="cerca" type="search" name="cerca" value="@Cerca" /></div>
        <div class="field"><label for="utente">Utente</label><input id="utente" name="utente" value="@Utente" /></div>
        <div class="field"><label for="dal">Dal</label><input id="dal" type="date" name="dal" value="@Dal?.ToString("yyyy-MM-dd")" /></div>
        <div class="field"><label for="al">Al</label><input id="al" type="date" name="al" value="@Al?.ToString("yyyy-MM-dd")" /></div>
        <div class="filters-note"><button class="btn" type="submit">Filtra</button></div>
    </form>
    <div class="scroll">
        <table>
            <thead><tr><th>Quando</th><th>Utente</th><th>Azione</th><th>Contratto</th><th>Bozza</th><th>Descrizione</th></tr></thead>
            <tbody>
                @foreach (VoceRegistro v in _voci)
                {
                    <tr>
                        <td class="nowrap">@Formato.DataOra(v.DataOra)</td>
                        <td>@v.Utente</td>
                        <td><span class="pill info">@v.Azione</span></td>
                        <td>@if (v.Contratto != "") { <a href="listini/@Uri.EscapeDataString(v.Contratto)">@v.Contratto</a> }</td>
                        <td class="mono">@(v.IdBozza is int b ? $"B-{b:0000}" : "")</td>
                        <td>@v.Descrizione</td>
                    </tr>
                }
                @if (_voci.Count == 0)
                {
                    <tr><td colspan="6" class="vuoto">Nessuna voce nel registro con questi filtri.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    [SupplyParameterFromQuery] private string? Cerca { get; set; }
    [SupplyParameterFromQuery] private string? Utente { get; set; }
    [SupplyParameterFromQuery] private DateTime? Dal { get; set; }
    [SupplyParameterFromQuery] private DateTime? Al { get; set; }

    private IReadOnlyList<VoceRegistro> _voci = Array.Empty<VoceRegistro>();

    protected override void OnParametersSet() => _voci = Registro.Cerca(Cerca, Utente, null, Dal, Al);
}
