<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>GdoWSC</AssemblyName>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Incasbo.Web.Library.modGeneral" Static="true" />
    <Using Include="Incasbo.Web.Library.DBFormatFunctions" Static="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../IboClassLib/IboClassLib.csproj" />
    <ProjectReference Include="../GdoParamsDefault/GdoParamsDefault.csproj" />
    <ProjectReference Include="../IboWebParam/IboWebParam.csproj" />
    <ProjectReference Include="../AppApi/AppApi.csproj" />
    <ProjectReference Include="../IboDbLib/IboDbLib.csproj" />
    <ProjectReference Include="../GdoApi/GdoApi.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Services" />
    <Reference Include="System.Data" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Core" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <!--
    .NET 8: i servizi sono ospitati da GdoWSC.Host (CoreWCF per WCF, middleware SOAP per GdoWSC.asmx).
    Il codice ASMX compila grazie a Incasbo.Web.Compat; Global.asax e le SoapExtension restano solo in net48
    (la loro logica e' riprodotta nell'host).
  -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'">
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.0" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.0" />
    <PackageReference Include="CoreWCF.Primitives" Version="1.6.0" />
    <PackageReference Include="CoreWCF.Http" Version="1.6.0" />
    <Compile Remove="Incasbo/Global_asax.cs" />
    <Compile Remove="Incasbo.My/**" />
    <Compile Remove="Incasbo.Web.WSC.SOAPExtensionsLib/**" />
    <Compile Remove="Incasbo.Web.WSC/IWSCBackgroundActivity.cs" />
    <Compile Remove="Incasbo.Web.WSC/CustomBackgroundActivity.cs" />
  </ItemGroup>
</Project>
