{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GdoWSC": {
    // Cartella con IniConfig\ e Log\ (come la cartella del sito IIS attuale). Vuoto = cartella dell'applicazione.
    "ApplicationRoot": "",
    // Indirizzi dei servizi: uguali ai file .svc del sito attuale, cosi' i client non cambiano
    "TMSServiceForWMSPath": "/TMSServiceForWMS.svc",
    "TMSApiServicePath": "/TMSApiService.svc",
    "TMSServiceForMapPath": "/TMSServiceForMap.svc",
    // Client verso WMS e PTV: copia del vecchio Web.config (serve solo la sezione <system.serviceModel>).
    // Non usare il web.config del nuovo sito: quello e' generato dalla pubblicazione per IIS.
    "WcfClientConfigFile": "IniConfig\\WcfClients.config",
    // Manutenzione periodica (prima in Global.asax)
    "BackgroundMaintenanceEnabled": true,
    "BackgroundMaintenanceIntervalSeconds": 60,
    // GdoWSC.asmx: valori uguali a <sessionState> e <forms> del Web.config attuale
    "Asmx": {
      "Path": "/GdoWSC.asmx",
      "SessionTimeoutMinutes": 10,
      "SessionCookieName": "ASP.NET_SessionId",
      "AuthCookieName": "GdoWSC",
      "AuthCookiePath": "/",
      "AuthTimeoutMinutes": 10
    }
  }
}
