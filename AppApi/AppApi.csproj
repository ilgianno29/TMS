<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AppApi</AssemblyName>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Incasbo.Web.Library.modGeneral" Static="true" />
    <Using Include="Incasbo.Web.Library.DBFormatFunctions" Static="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Data" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'">
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>
  <!--
    Crystal Reports: su .NET 4.8 si usa l'IboCRW originale (lo estende anche il portale);
    su .NET 8 Crystal non esiste e IboCRW.Stub.cs lo sostituisce (report da rifare).
    Le DLL reali vanno in lib/Crystal; se mancano si compila con gli stub (solo verifica).
  -->
  <PropertyGroup>
    <CrystalReale Condition="Exists('../lib/Crystal/CrystalDecisions.CrystalReports.Engine.dll')">true</CrystalReale>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'">
    <Compile Remove="Incasbo.Api.App/IboCRW.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Compile Remove="Incasbo.Api.App/IboCRW.Stub.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' And '$(CrystalReale)' == 'true'">
    <Reference Include="CrystalDecisions.CrystalReports.Engine"><HintPath>../lib/Crystal/CrystalDecisions.CrystalReports.Engine.dll</HintPath></Reference>
    <Reference Include="CrystalDecisions.Shared"><HintPath>../lib/Crystal/CrystalDecisions.Shared.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' And '$(CrystalReale)' != 'true'">
    <ProjectReference Include="../CrystalStubs/CrystalStubs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../IboClassLib/IboClassLib.csproj" />
    <ProjectReference Include="../IboDbLib/IboDbLib.csproj" />
    <ProjectReference Include="../IboWebParam/IboWebParam.csproj" />
  </ItemGroup>
</Project>
